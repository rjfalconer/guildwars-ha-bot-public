		Func travelto($amapid, $adis = 0)
			If getmapid() = $amapid AND $adis = 0 AND getmaploading() = 0 Then Return True
			zonemap($amapid, $adis)
			Return waitmaploading($amapid)
		EndFunc

		Func zonemap($amapid, $adistrict = 0)
			movemap($amapid, getregion(), $adistrict, getlanguage())
		EndFunc


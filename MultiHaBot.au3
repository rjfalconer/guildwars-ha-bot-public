	While getmaploading() == $instancetype_explorable AND getmapid() == $unholytemples
		If $iam = $iamblue Then
			unholyblue()
			If $iamwonunholytemples < getherotitle() Then
				If getisliving(getmyid()) Then
					If getmapid() == $unholytemples Then
						out("won in Unholy")
						Sleep(5000)
						waitmaploading()
					EndIf
				EndIf
			EndIf
		EndIf
		If $iam = $iamred Then
			unholyred()
			If $iamwonunholytemples < getherotitle() Then
				If getisliving(getmyid()) Then
					If getmapid() == $unholytemples Then
						out("won in Unholy")
						fameup()

		Func createstringlog()
			_("StringLogProc:")
			_("pushad")
			_("mov eax,dword[NextStringType]")
			_("test eax,eax")
			_("jz StringLogExit")
			_("cmp eax,1")
			_("jnz StringLogFilter2")
			_("mov eax,dword[ebp+37c]")
			_("jmp StringLogRangeCheck")
			_("StringLogFilter2:")
			_("cmp eax,2")
			_("jnz StringLogExit")
			_("mov eax,dword[ebp+338]")
			_("StringLogRangeCheck:")
			_("mov dword[NextStringType],0")
			_("cmp eax,0")
			_("jbe StringLogExit")
			_("cmp eax,StringLogSize")
			_("jae StringLogExit")
			_("shl eax,8")
			_("add eax,StringLogBase")
			_("xor ebx,ebx")
			_("StringLogCopyLoop:")
			_("mov dx,word[ecx]")
			_("mov word[eax],dx")
			_("add ecx,2")
			_("add eax,2")
			_("inc ebx")
			_("cmp ebx,80")
			_("jz StringLogExit")
			_("test dx,dx")
			_("jnz StringLogCopyLoop")
			_("StringLogExit:")
			_("popad")
			_("mov esp,ebp")
			_("pop ebp")
			_("retn 10")
		EndFunc


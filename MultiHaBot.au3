			_("mov dword[eax+4],ecx")
			_("mov ecx,dword[edi+4]")
			_("mov dword[eax+8],ecx")
			_("push 3")
			_("push eax")
			_("push CallbackEvent")
			_("push dword[CallbackHandle]")
			_("call dword[PostMessage]")
			_("pop eax")
			_("inc eax")
			_("cmp eax,SkillLogSize")

			If IsDllStruct($aagent) = 0 Then
				$lagentid = convertid($aagent)
			Else
				$lagentid = DllStructGetData($aagent, "ID")
			EndIf
			Return sendpacket(12, 31, $lagentid, $acalltarget)
		EndFunc

